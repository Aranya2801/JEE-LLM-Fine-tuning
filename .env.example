# ============================================================
# .env.example — Copy to .env and fill in your credentials
# ============================================================

# HuggingFace (for downloading gated models like LLaMA-3)
HF_TOKEN=hf_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# OpenAI (for CoT generation via GPT-4o)
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Anthropic (optional: for data validation)
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Weights & Biases (for experiment tracking)
WANDB_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
WANDB_PROJECT=jee-llm-finetuning
WANDB_ENTITY=your_wandb_username

# Model paths
JEE_MODEL_PATH=checkpoints/jee-llm-v1
JEE_DEVICE=cuda

# Training settings
CUDA_VISIBLE_DEVICES=0
TOKENIZERS_PARALLELISM=false
NCCL_DEBUG=WARN

# API Server
API_HOST=0.0.0.0
API_PORT=8000
